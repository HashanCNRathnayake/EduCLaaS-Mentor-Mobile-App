# Mobile App Environment Configuration
# Copy this file to .env and fill in your actual values

# Microsoft Entra (Azure AD) Configuration
# Get these from your Azure App Registration
EXPO_PUBLIC_ENTRA_CLIENT_ID=your-entra-client-id-here
EXPO_PUBLIC_ENTRA_TENANT_ID=your-entra-tenant-id-here

# API Endpoint Configuration
# For Android Emulator: use 10.0.2.2 (maps to localhost on your PC)
# For Physical Device: use your PC's LAN IP (e.g., http://192.168.1.50)
# For Production: use your actual server domain (e.g., https://yourdomain.com)
EXPO_PUBLIC_API_URL=http://10.0.2.2/mentor-app/copilot-api/chat.php

# Notes:
# - The redirect URI in your Azure app registration must be: copilotmobile://auth/callback
# - Keep sensitive values (client IDs) out of version control
# - Never commit this file; use .env.example as template instead
