# Backend API Environment Configuration
# Copy this file to .env and fill in your actual values

# Azure Bot Service - Direct Line Configuration
# Get these from your Azure Bot Service resource
DIRECTLINE_SECRET=your-directline-secret-key-here
DIRECTLINE_ENDPOINT=https://directline.botframework.com/v3/directline

# Notes:
# - DIRECTLINE_SECRET: Found in Azure Portal > Your Bot Resource > Settings > Channels > Direct Line
# - DIRECTLINE_ENDPOINT: The base endpoint for Direct Line API (usually the default value shown)
# - Never commit this file; use .env.example as template instead
# - Keep secrets secure and rotate them periodically
